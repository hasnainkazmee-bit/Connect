DATABASE_URL=postgres://sunhub:sunhub_local@localhost:5438/sunhub_community
PORT=4100
APP_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
NODE_ENV=development

# Run node tools/setup-local.mjs to generate local secrets and start Docker services.
# The values below are examples. Keep credentials in .env, never source control.
REQUIRE_EMAIL_VERIFICATION=true
# Optional first-party OIDC provider. HTTPS required in production.
SUNHUB_SSO_ISSUER=
SUNHUB_SSO_CLIENT_ID=sunhub-connect
AUTH_TOKEN_SECRET=
STORAGE_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=connect-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
COMPANY_STORAGE_LIMIT_BYTES=5368709120
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_FROM=Connect <hello@connect.local>
# Optional background push delivery. Generate VAPID keys once and retain them.
# Public key is safe for browser clients; keep the private key outside Git.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:connect@sunhubapp.com
# Mount the Firebase service-account JSON read-only; never paste it into source.
FIREBASE_SERVICE_ACCOUNT_FILE=
# For a real sender: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD,
# SMTP_REQUIRE_TLS=true and a verified MAIL_FROM address.
