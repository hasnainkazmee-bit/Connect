{
  "name": "sunhub-community",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api",
    "directory:import": "node apps/api/dist/import-directory.js",
    "directory:import-master": "node apps/api/dist/import-master-companies.js",
    "directory:cache-logos": "node apps/api/dist/import-company-logos.js",
    "directory:claims": "node apps/api/dist/review-claims.js",
    "directory:credentials": "node apps/api/dist/import-credentials.js",
    "credentials:research": "python3 tools/research-credentials.py",
    "credentials:batch": "python3 tools/build-credential-batch.py",
    "test:credential-research": "python3 tests/credential-research.test.py",
    "test": "node tests/run.mjs",
    "test:ui": "node tests/run.mjs --ui",
    "test:android-core": "node tests/run.mjs --rust",
    "test:android": "node tests/run.mjs --android",
    "build:macos": "./apps/macos/build.sh",
    "package:macos": "./apps/macos/package.sh",
    "test:macos": "./apps/macos/test-policy.sh && ./apps/macos/test-webkit.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
